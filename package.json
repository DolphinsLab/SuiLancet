{
  "name": "sui-lancet",
  "version": "2.0.0",
  "type": "module",
  "description": "SuiLancet - Sui on-chain utility toolkit",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "sui-lancet": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "build:cli": "tsup --config tsup.config.ts",
    "dev": "tsup --watch",
    "dev:cli": "bun run src/cli/index.ts",
    "cli": "node dist/cli/index.js",
    "test": "vitest run --globals",
    "clean": "rm -rf dist node_modules"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@mysten/sui": "2.23.1",
    "bip39": "^3.1.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5"
  }
}
